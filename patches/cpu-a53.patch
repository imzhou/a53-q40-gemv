                 if (GGML_CPU_ARM_ARCH)
                     list(APPEND ARCH_FLAGS -march=${GGML_CPU_ARM_ARCH})
+                    # 32-bit Android on Cortex-A53: hardware FP16 convert (vcvtb)
+                    # without ARMv8.2 +dotprod/+fp16. Scoped to ggml-cpu only.
+                    if (ANDROID AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm")
+                        list(APPEND ARCH_FLAGS -mcpu=cortex-a53 -mfpu=neon-fp-armv8)
+                        if (GGML_CPU_FP_CONTRACT_OFF)
+                            list(APPEND ARCH_FLAGS -ffp-contract=off)
+                        endif()
+                    endif()
                 elseif(GGML_CPU_ALL_VARIANTS)
                     # Begin with the lowest baseline
                     set(ARM_MCPU "armv8-a")
